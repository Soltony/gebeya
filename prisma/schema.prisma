// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// AUTH & USERS
// --------------------------------------

model User {
  id                          String                @id @default(cuid())
  fullName                    String
  email                       String                @unique
  phoneNumber                 String                @unique
  password                    String
  passwordChangeRequired      Boolean               @default(true)
  status                      String
  roleId                      String
  role                        Role                  @relation(fields: [roleId], references: [id])
  sessions                    Session[]
  loanProviderId              String?
  loanProvider                LoanProvider?         @relation(fields: [loanProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId                    String?
  branch                      Branch?               @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  merchantId                  String?
  merchant                    Merchant?             @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdChanges              PendingChange[]       @relation("CreatedBy")
  approvedChanges             PendingChange[]       @relation("ApprovedBy")
  updatedDisbursementControls DisbursementControl[] @relation("DisbursementControlUpdatedBy")
  manualRepaymentsEntered     ManualRepayment[]     @relation("ManualRepaymentMaker")
  manualRepaymentsChecked     ManualRepayment[]     @relation("ManualRepaymentChecker")
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String @db.NVarChar(Max) // JSON string for permissions
  users       User[]
}

// Sessions for refresh-token management and revocation support
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  // JTI (JWT ID) of the currently issued access token bound to this DB session.
  // Used to revoke access tokens by invalidating the stored JTI on logout/rotation.
  jti          String?
  revoked      Boolean  @default(false)
  expiresAt    DateTime // refresh token expiry
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([jti])
}

// --------------------------------------
// SYSTEM CONTROLS
// --------------------------------------

// Global kill-switch for all disbursements (external + internal).
// Single-row table with id = 'global'.
model DisbursementControl {
  id          String   @id @default("global")
  enabled     Boolean  @default(true)
  updatedById String?
  updatedBy   User?    @relation("DisbursementControlUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}

// --------------------------------------
// LOAN MANAGEMENT
// --------------------------------------

model LoanProvider {
  id                      String                        @id @default(cuid())
  name                    String                        @unique
  icon                    String                        @db.Text
  colorHex                String
  displayOrder            Int
  accountNumber           String?
  collectionAccount       String? // additional field for collection account
  startingCapital         Float
  initialBalance          Float
  allowCrossProviderLoans Boolean                       @default(false)
  nplThresholdDays        Int                           @default(60)
  status                  String                        @default("ACTIVE") // ACTIVE, PENDING_APPROVAL
  products                LoanProduct[]
  scoringParameters       ScoringParameter[]
  scoringHistory          ScoringConfigurationHistory[]
  dataProvisioningConfigs DataProvisioningConfig[]
  users                   User[]
  ledgerAccounts          LedgerAccount[]
  journalEntries          JournalEntry[]
  termsAndConditions      TermsAndConditions[]
  deliveryAgreementTemplates DeliveryAgreementTemplate[]
  distributions           ProviderDistribution[]
}

model ProviderDistribution {
  id                     String       @id @default(cuid())
  providerId             String
  provider               LoanProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // External provider identifier sent to the upstream distribution service.
  externalProviderId     String?
  distributionDate       DateTime
  interestAmount         Float        @default(0)
  serviceFeeAmount       Float        @default(0)
  penaltyAmount          Float        @default(0)
  taxAmount              Float        @default(0)
  totalDistributedAmount Float        @default(0)
  distributionReference  String?
  createdAt              DateTime     @default(now())

  @@unique([providerId, distributionDate])
  @@index([distributionDate])
}

model LoanProduct {
  id                       String                        @id @default(cuid())
  providerId               String
  provider                 LoanProvider                  @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name                     String
  description              String
  icon                     String                        @db.Text
  minLoan                  Float?
  maxLoan                  Float?
  isSalaryAdvance          Boolean                       @default(false)
  advancePercent           Int?
  salaryAdvanceMappings    String?                       @db.NVarChar(Max) // JSON: [{ accountNumber, salary }]
  duration                 Int
  installments             Int?
  repaymentIntervalDays    Int?
  status                   String                        @default("Active") // Active, Disabled, PENDING_APPROVAL
  allowConcurrentLoans     Boolean                       @default(false)
  serviceFee               String // JSON FeeRule
  serviceFeeEnabled        Boolean?
  dailyFee                 String // JSON FeeRule
  dailyFeeEnabled          Boolean?
  penaltyRules             String // JSON array of PenaltyRule
  penaltyRulesEnabled      Boolean?
  // If true, penalty rules are applied per installment
  // (useful for salary-advance products that have installment schedules)
  penaltyPerInstallment    Boolean?                      @default(false)
  dataProvisioningEnabled  Boolean?
  dataProvisioningConfigId String?
  dataProvisioningConfig   DataProvisioningConfig?       @relation(fields: [dataProvisioningConfigId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eligibilityFilter        String?                       @db.Text // JSON object for filtering borrowers
  // Optional Loan Cycle configuration id - controls how much of a tier a borrower can access
  // loanCycleConfigId and explicit FK were removed to avoid duplicate FKs.
  // LoanCycleConfig.productId is the single-source foreign key for the relation.
  loanCycleConfig          LoanCycleConfig?
  eligibilityUploadId      String?
  eligibilityUpload        DataProvisioningUpload?       @relation(fields: [eligibilityUploadId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  loans                    Loan[]
  loanAmountTiers          LoanAmountTier[]
  scoringConfiguration     ScoringConfigurationProduct[]
  loanApplications         LoanApplication[]
  requiredDocuments        RequiredDocument[]

  @@unique([name, providerId])
}

model LoanCycleConfig {
  id          String      @id @default(cuid())
  productId   String      @unique
  product     LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Metric controlling cycle progression: 'PAID_EARLY' | 'PAID_LATE' | 'TOTAL_COUNT' | 'PAID_ON_TIME'
  metric      String
  // Whether product-level cycle feature is enabled
  enabled     Boolean     @default(true)
  // JSON array of cycle range descriptors or objects. Example: [{"label":"0-1","min":0,"max":1},{"label":"1-4","min":1,"max":4}]
  cycleRanges String?     @db.NVarChar(Max)
  // JSON array of grade rows. Each row should include label, minScore and `percentages` array aligned with cycleRanges.
  // Example: [{"label":"A","minScore":700,"percentages":[35,50,80]}]
  grades      String?     @db.NVarChar(Max)
  // (backwards-compatible) legacy flat cycles list -- preserved for older deployments
  cycles      String?     @db.NVarChar(Max)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Loan {
  id                         String                    @id @default(cuid())
  borrowerId                 String
  borrower                   Borrower                  @relation(fields: [borrowerId], references: [id])
  productId                  String
  product                    LoanProduct               @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loanApplicationId          String                    @unique
  loanApplication            LoanApplication           @relation(fields: [loanApplicationId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  loanAmount                 Float
  serviceFee                 Float
  penaltyAmount              Float
  disbursedDate              DateTime
  dueDate                    DateTime
  repaymentStatus            String // Paid, Unpaid
  repaymentBehavior          String? // ON_TIME, LATE, EARLY
  repaidAmount               Float?
  // Interest accrual tracking (for daily ledger accrual)
  interestAccruedAmount      Float                     @default(0)
  interestAccruedThroughDate DateTime?
  // Penalty accrual tracking (for daily ledger accrual)
  penaltyAccruedAmount       Float                     @default(0)
  penaltyAccruedThroughDate  DateTime?
  taxDeducted                Float                     @default(0) // Inclusive tax amount deducted upfront
  netDisbursedAmount         Float?                    // Actual amount disbursed after inclusive tax deduction
  payments                   Payment[]
  installments               LoanInstallment[]
  journalEntries             JournalEntry[]
  pendingPayments            PendingPayment[]
  manualRepayments           ManualRepayment[]
  disbursementTransactions   DisbursementTransaction[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
}

model Payment {
  id                              String           @id @default(cuid())
  loanId                          String
  loan                            Loan             @relation(fields: [loanId], references: [id])
  installmentId                   String?
  installment                     LoanInstallment? @relation(fields: [installmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount                          Float
  date                            DateTime
  outstandingBalanceBeforePayment Float?
  journalEntryId                  String?          @unique
  journalEntry                    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model LoanInstallment {
  id                String    @id @default(cuid())
  loanId            String
  loan              Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  paidAmount        Float?    @default(0)
  paidAt            DateTime?
  status            String    @default("PENDING") // PENDING, PAID, LATE
  penaltyAmount     Float     @default(0)
  isActive          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments Payment[]

  @@index([loanId])
  @@index([dueDate])
}

model Borrower {
  id                      String                    @id
  status                  String                    @default("Active") // Active, NPL
  provisionedData         ProvisionedData[]
  loans                   Loan[]
  agreements              BorrowerAgreement[]
  loanApplications        LoanApplication[]
  pendingPayments         PendingPayment[]
  directPendingPayments   DirectPendingPayment[]
  accountStatements       AccountStatement[]
  accountStatementMetrics AccountStatementMetrics[]
  orders                  Order[]
}

// --------------------------------------
// LOAN APPLICATION & DOCUMENTS
// --------------------------------------

model LoanApplication {
  id                String             @id @default(cuid())
  borrowerId        String
  borrower          Borrower           @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  productId         String
  product           LoanProduct        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loanAmount        Float?
  status            String             @default("PENDING_DOCUMENTS") // PENDING_DOCUMENTS, PENDING_REVIEW, NEEDS_REVISION, APPROVED, DISBURSED
  rejectionReason   String?            @db.Text
  loan              Loan?
  orders            Order[]
  uploadedDocuments UploadedDocument[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model RequiredDocument {
  id                String             @id @default(cuid())
  productId         String
  product           LoanProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  uploadedDocuments UploadedDocument[]
}

model UploadedDocument {
  id                 String           @id @default(cuid())
  loanApplicationId  String
  application        LoanApplication  @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  requiredDocumentId String
  requiredDocument   RequiredDocument @relation(fields: [requiredDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fileName           String
  fileType           String
  fileContent        String           @db.Text // Should be a URL in production, Base64 for simplicity
  status             String           @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy         String?
  reviewedAt         DateTime?

  @@unique([loanApplicationId, requiredDocumentId])
}

// --------------------------------------
// DATA & SCORING
// --------------------------------------

model DataProvisioningConfig {
  id              String                   @id @default(cuid())
  providerId      String
  provider        LoanProvider             @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name            String
  columns         String                   @db.NVarChar(Max) // JSON array of DataColumn
  uploads         DataProvisioningUpload[]
  provisionedData ProvisionedData[]
  products        LoanProduct[]
}

model DataProvisioningUpload {
  id              String                 @id @default(cuid())
  configId        String
  config          DataProvisioningConfig @relation(fields: [configId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fileName        String
  rowCount        Int
  uploadedBy      String
  uploadedAt      DateTime               @default(now())
  provisionedData ProvisionedData[]
  LoanProduct     LoanProduct[]
}

model ProvisionedData {
  id         String                  @id @default(cuid())
  borrowerId String
  borrower   Borrower                @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  configId   String
  config     DataProvisioningConfig  @relation(fields: [configId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadId   String?
  upload     DataProvisioningUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  data       String // JSON string of the uploaded data for this borrower
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  // Make provisioned data unique per-upload so we can retain previous uploads
  // and avoid overwriting older uploaded lists when a new upload is processed.
  @@unique([borrowerId, configId, uploadId])
}

model ScoringParameter {
  id         String       @id @default(cuid())
  providerId String
  provider   LoanProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  weight     Int
  rules      Rule[]
}

model Rule {
  id          String           @id @default(cuid())
  parameterId String
  parameter   ScoringParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  field       String
  condition   String
  value       String
  score       Int
}

model LoanAmountTier {
  id         String      @id @default(cuid())
  productId  String
  product    LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromScore  Int
  toScore    Int
  loanAmount Float
}

model ScoringConfigurationHistory {
  id              String                        @id @default(cuid())
  providerId      String
  provider        LoanProvider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  parameters      String                        @db.NVarChar(Max) // JSON string of ScoringParameter[]
  savedAt         DateTime                      @default(now())
  appliedProducts ScoringConfigurationProduct[]
}

model ScoringConfigurationProduct {
  id         String                      @id @default(cuid())
  configId   String
  config     ScoringConfigurationHistory @relation(fields: [configId], references: [id], onDelete: Cascade)
  productId  String
  product    LoanProduct                 @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedAt DateTime                    @default(now())
  assignedBy String

  @@unique([configId, productId])
}

// --------------------------------------
// ACCOUNTING
// --------------------------------------

model LedgerAccount {
  id         String        @id @default(cuid())
  providerId String
  provider   LoanProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  type       String // Receivable, Received, Income
  category   String // Principal, Interest, ServiceFee, Penalty, Tax
  balance    Float         @default(0)
  entries    LedgerEntry[]

  @@unique([providerId, name])
}

model JournalEntry {
  id          String        @id @default(cuid())
  providerId  String
  provider    LoanProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  loanId      String?
  loan        Loan?         @relation(fields: [loanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        DateTime
  description String
  entries     LedgerEntry[]
  payment     Payment?
}

model LedgerEntry {
  id              String        @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type            String // Debit or Credit
  amount          Float
}

// --------------------------------------
// AGREEMENTS
// --------------------------------------

model TermsAndConditions {
  id          String              @id @default(cuid())
  providerId  String
  provider    LoanProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  content     String              @db.Text
  version     Int
  isActive    Boolean             @default(false)
  publishedAt DateTime
  agreements  BorrowerAgreement[]

  @@unique([providerId, version])
}

model BorrowerAgreement {
  id         String             @id @default(cuid())
  borrowerId String
  borrower   Borrower           @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  termsId    String
  terms      TermsAndConditions @relation(fields: [termsId], references: [id], onDelete: Cascade)
  acceptedAt DateTime           @default(now())

  @@unique([borrowerId, termsId])
}

// --------------------------------------
// TAX
// --------------------------------------

model Tax {
  id          String  @id @default(cuid())
  name        String?
  rate        Float   @default(0)
  appliedTo   String // JSON string: e.g., ["serviceFee", "interest", "penalty"]
  isInclusive Boolean @default(false) // When true, tax is deducted upfront from principal before disbursement
  status      String  @default("ACTIVE") // ACTIVE, PENDING_APPROVAL
}

// --------------------------------------
// AUDITING & APPROVALS
// --------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String?
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
}

model PendingChange {
  id              String    @id @default(cuid())
  entityType      String // e.g., "LoanProvider", "LoanProduct", "Tax"
  entityId        String? // The ID of the entity being changed. Null for CREATE.
  changeType      String // CREATE, UPDATE, DELETE
  payload         String    @db.NVarChar(Max) // JSON payload with the changes
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdById     String
  createdBy       User      @relation("CreatedBy", fields: [createdById], references: [id], onUpdate: NoAction, onDelete: NoAction)
  approvedById    String?
  approvedBy      User?     @relation("ApprovedBy", fields: [approvedById], references: [id], onUpdate: NoAction, onDelete: NoAction)
  approvedAt      DateTime?
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([entityType])
}

// --------------------------------------
// PAYMENT GATEWAY
// --------------------------------------
model PendingPayment {
  id            String   @id @default(cuid())
  transactionId String   @unique
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  borrowerId    String
  borrower      Borrower @relation(fields: [borrowerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  amount        Float
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  txnRef        String?
  paymentType   String   @default("BNPL") // BNPL or DIRECT
  status        String // e.g., RECEIVED, PROCESSED, FAILED_VALIDATION
  payload       String   @db.NVarChar(Max)
  receivedAt    DateTime @default(now())
}

// Records disbursement requests sent to the external payment/disbursement service
model DisbursementTransaction {
  id                 String   @id @default(cuid())
  transactionId      String? // transaction id returned by upstream, if any
  loanId             String?
  loan               Loan?    @relation(fields: [loanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  providerId         String
  originalProviderId String? // provider id received from caller before any forced override
  creditAccount      String
  amount             Float?
  disbursementStatus String   @default("PENDING") // PENDING, SENT, SUCCESS, FAILED
  requestPayload     String   @db.NVarChar(Max)
  responsePayload    String?  @db.NVarChar(Max)
  rawResponse        String?  @db.NVarChar(Max)
  statusCode         Int?
  createdAt          DateTime @default(now())

  @@index([loanId])
  @@index([providerId])
  @@index([transactionId])
  @@index([disbursementStatus])
}

// Maps phone numbers to external bank account numbers returned by the
// external 'get-accounts' service. A phoneNumber can have multiple
// account entries; at most one may be marked as active for loan use.
model PhoneAccount {
  id            String   @id @default(cuid())
  phoneNumber   String
  accountNumber String
  customerName  String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([phoneNumber, accountNumber])
  @@index([phoneNumber])
}

// Account statements retrieved from the external account-statement service
model AccountStatement {
  id             String                 @id @default(cuid())
  borrowerId     String
  borrower       Borrower               @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  accountNumber  String
  customerName   String?
  currency       String?
  openingBalance String?
  closingBalance String?
  startDate      String?
  endDate        String?
  raw            String                 @db.NVarChar(Max) // raw JSON response as string
  fetchedAt      DateTime               @default(now())
  lines          AccountStatementLine[]

  @@unique([borrowerId, accountNumber, startDate, endDate])
  @@index([borrowerId])
  @@index([accountNumber])
}

model AccountStatementLine {
  id             String           @id @default(cuid())
  statementId    String
  statement      AccountStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  bookDate       String?
  reference      String?
  description    String?
  narrative      String?
  valueDate      String?
  debit          Float?
  credit         Float?
  closingBalance Float?
}

// Precomputed metrics for an account over a specific period (e.g., last 6 months)
model AccountStatementMetrics {
  id                       String   @id @default(cuid())
  borrowerId               String
  borrower                 Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  accountNumber            String
  periodStart              String // YYYYMMDD
  periodEnd                String // YYYYMMDD
  monthsAtEbirr            Int?
  txCountRelevant          Int?
  billPaymentsCount        Int?
  avgMonthlyDeposit        Float?
  avgUniqueDepositSources  Float?
  avgMonthlyAirtimeCount   Float?
  avgMonthlyAirtimeValue   Float?
  withdrawalToDepositRatio Float?
  avgBalance               Float?
  derived                  String   @db.NVarChar(Max) // JSON for additional metrics
  computedAt               DateTime @default(now())

  @@unique([borrowerId, accountNumber, periodStart, periodEnd])
  @@index([borrowerId])
  @@index([accountNumber])
}

// --------------------------------------
// SMS MANAGEMENT
// --------------------------------------

// SMS Templates for customizable message content
model SmsTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  content     String    @db.NVarChar(Max)
  // Description of available placeholders: {{borrowerName}}, {{loanAmount}}, {{dueDate}}, {{productName}}, {{outstandingAmount}}, {{daysOverdue}}
  description String?   @db.NVarChar(Max)
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  smsLogs     SmsLog[]
  smsCampaigns SmsCampaign[]
}

// Individual SMS log records
model SmsLog {
  id              String       @id @default(cuid())
  templateId      String?
  template        SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaignId      String?
  campaign        SmsCampaign? @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipientPhone  String
  recipientName   String?
  loanId          String?
  productId       String?
  productName     String?
  messageContent  String       @db.NVarChar(Max)
  status          String       @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  errorMessage    String?      @db.NVarChar(Max)
  sentAt          DateTime?
  deliveredAt     DateTime?
  retryCount      Int          @default(0)
  lastRetryAt     DateTime?
  parentSmsId     String?      // For tracking resends
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([recipientPhone])
  @@index([loanId])
  @@index([productId])
  @@index([campaignId])
  @@index([createdAt])
}

// SMS Campaigns for bulk/scheduled sending
model SmsCampaign {
  id                String       @id @default(cuid())
  name              String
  templateId        String?
  template          SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Targeting criteria stored as JSON
  targetCriteria    String       @db.NVarChar(Max) // JSON: { productIds: [], loanAgeFrom: number, loanAgeTo: number, overdueFrom: number, overdueTo: number, customDateField: string, customDateFrom: date, customDateTo: date }
  customMessage     String?      @db.NVarChar(Max) // Optional override message
  status            String       @default("DRAFT") // DRAFT, SCHEDULED, PROCESSING, COMPLETED, CANCELLED
  scheduleType      String       @default("IMMEDIATE") // IMMEDIATE, SCHEDULED
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  totalRecipients   Int          @default(0)
  sentCount         Int          @default(0)
  deliveredCount    Int          @default(0)
  failedCount       Int          @default(0)
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  smsLogs           SmsLog[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

// --------------------------------------
// BNPL / COMMERCE
// --------------------------------------

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("ACTIVE")
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String          @id @default(cuid())
  name           String
  districtId     String
  district       District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  status         String          @default("ACTIVE")
  stockLocations StockLocation[]
  users          User[]
  merchants      Merchant[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([name, districtId])
}

model Merchant {
  id                    String   @id @default(cuid())
  name                  String   @unique
  accountNumber         String?  @unique
  branchId              String?
  branch                Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  iconUrl               String?  @db.Text
  contactPersonName     String?
  contactPersonPhone    String?
  contactPersonEmail    String?
  additionalContactInfo String?  @db.Text
  bnplEnabled           Boolean  @default(true)
  status                String   @default("PENDING_APPROVAL")
  items                 Item[]
  orders                Order[]
  directPendingPayments DirectPendingPayment[]
  users                 User[]
  discountRules         DiscountRule[]
  stockLocations        StockLocation[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ProductCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  status        String         @default("ACTIVE")
  items         Item[]
  discountRules DiscountRule[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Item {
  id              String           @id @default(cuid())
  merchantId      String
  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name            String
  description     String?          @db.Text
  price           Float
  imageUrl        String?          @db.Text
  videoUrl        String?          @db.Text
  currency        String           @default("ETB")
  sellingOption   String           @default("BNPL_ONLY")
  status          String           @default("ACTIVE")
  stockQuantity   Int              @default(0)
  requiresMerchantAvailabilityConfirmation Boolean @default(true)
  variants        ItemVariant[]
  optionGroups    ItemOptionGroup[]
  discountRules   DiscountRule[]
  orderItems                 OrderItem[]
  inventoryLevels            InventoryLevel[]
  combinationInventoryLevels CombinationInventoryLevel[]
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
}

model ItemVariant {
  id         String      @id @default(cuid())
  itemId     String
  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name       String
  size       String?
  color      String?
  material   String?
  price      Float
  status     String      @default("ACTIVE")
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([itemId])
}

model ItemOptionGroup {
  id        String            @id @default(cuid())
  itemId    String
  item      Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  // ACTIVE or ARCHIVED. A group a past order still points at is archived
  // rather than deleted, because OrderItemOptionSelection.optionValueId is a
  // NoAction foreign key that rejects the delete.
  status    String            @default("ACTIVE")
  values    ItemOptionValue[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([itemId])
}

model ItemOptionValue {
  id         String                      @id @default(cuid())
  groupId    String
  group      ItemOptionGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Float                       @default(0)
  // ACTIVE or ARCHIVED, see ItemOptionGroup.status.
  status     String                      @default("ACTIVE")
  selections OrderItemOptionSelection[]
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@index([groupId])
}

model DiscountRule {
  id         String           @id @default(cuid())
  name       String
  type       String // PERCENT, FIXED, BUY_X_GET_Y
  value      Float            @default(0)
  buyX       Int?
  getY       Int?
  merchantId String?
  merchant   Merchant?        @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemId     String?
  item       Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  minQuantity Int             @default(1)
  startDate  DateTime?
  endDate    DateTime?
  status     String           @default("ACTIVE")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([merchantId])
  @@index([itemId])
  @@index([categoryId])
  @@index([startDate, endDate])
}

model Order {
  id                String           @id @default(cuid())
  borrowerId        String
  borrower          Borrower         @relation(fields: [borrowerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  merchantId        String
  merchant          Merchant         @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loanApplicationId String?
  loanApplication   LoanApplication? @relation(fields: [loanApplicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loanId            String?
  paymentType       String           @default("BNPL")
  // Where the customer placed the order: SUPER_APP or TELEGRAM.
  channel           String           @default("SUPER_APP")
  status            String           @default("PENDING_MERCHANT_CONFIRMATION")
  cancelReason      String?
  cancelledBy       String?
  totalAmount       Float            @default(0)
  currency          String           @default("ETB")
  orderItems            OrderItem[]
  deliveryOtps          DeliveryOtp[]
  directPendingPayments DirectPendingPayment[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([borrowerId])
  @@index([merchantId])
  @@index([status])
}

model OrderItem {
  id               String                      @id @default(cuid())
  orderId          String
  order            Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item                        @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId        String?
  variant          ItemVariant?                @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity         Int                         @default(1)
  unitPrice        Float
  lineTotal        Float
  optionSelections OrderItemOptionSelection[]
  createdAt        DateTime                    @default(now())

  @@index([orderId])
  @@index([itemId])
}

model OrderItemOptionSelection {
  id            String          @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ItemOptionValue @relation(fields: [optionValueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priceDelta    Float           @default(0)

  @@index([orderItemId])
}

model StockLocation {
  id                        String                     @id @default(cuid())
  name                      String
  address                   String?
  contactInfo               String?
  branchId                  String?
  branch                    Branch?                    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  merchantId                String?
  merchant                  Merchant?                  @relation(fields: [merchantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status                    String                     @default("ACTIVE")
  inventoryLevels           InventoryLevel[]
  combinationInventoryLevels CombinationInventoryLevel[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([merchantId])
}

model InventoryLevel {
  id              String        @id @default(cuid())
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  quantity        Int           @default(0)
  updatedAt       DateTime      @updatedAt

  @@unique([itemId, stockLocationId])
}

model CombinationInventoryLevel {
  id                String        @id @default(cuid())
  itemId            String
  item              Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId        String
  location          StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  combinationKey    String
  optionValueIds    String        @db.NVarChar(Max)
  quantityAvailable Int           @default(0)
  reservedQuantity  Int           @default(0)
  lowStockThreshold Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([itemId, locationId, combinationKey])
  @@index([itemId])
  @@index([locationId])
}

// --------------------------------------
// DIRECT PAYMENT GATEWAY
// (Separate from BNPL loan repayment tables)
// --------------------------------------

// Tracks pending direct payments for orders (not loan repayments). One row per
// payment attempt: a resent USSD push is a new row with a new transactionId.
model DirectPendingPayment {
  id              String           @id @default(cuid())
  transactionId   String           @unique
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  borrowerId      String
  borrower        Borrower         @relation(fields: [borrowerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  merchantId      String
  merchant        Merchant         @relation(fields: [merchantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  amount          Float
  // PENDING, COMPLETED, FAILED; USSD_PUSH also uses AWAITING_PIN (prompt sent)
  // and PROCESSING (bank reported a failure but money may have moved).
  status          String           @default("PENDING")
  // GATEWAY (super-app payment token) or USSD_PUSH (NIB push to the customer's phone).
  method          String           @default("GATEWAY")
  // USSD_PUSH only. Phone that received the PIN prompt.
  customerPhone   String?
  // USSD_PUSH only. The attempt's one-time ECDH private key and the secret it
  // agreed with the bank (both base64); they decrypt the bank's replies for
  // this attempt. Never log them or return them from an API.
  sharedSecret     String?
  clientPrivateKey String?
  // Bank's latest reason text, e.g. "Insufficient balance" or "server busy".
  statusDesc      String?          @db.NVarChar(500)
  payerAccount    String?
  // Last time the bank's status endpoint was asked about this attempt.
  statusCheckedAt DateTime?
  completedAt     DateTime?
  ft              DirectPaymentFt?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([orderId])
  @@index([borrowerId])
  @@index([method, status, createdAt])
}

/// Core-banking FT numbers recorded against direct payments. The primary key is
/// what lets one FT settle only one payment; it lives here because SQL Server
/// allows a single NULL in a unique index, so a nullable column on
/// DirectPendingPayment could not carry it.
model DirectPaymentFt {
  cbsReference           String               @id
  directPendingPaymentId String               @unique
  directPendingPayment   DirectPendingPayment @relation(fields: [directPendingPaymentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  createdAt              DateTime             @default(now())
}

// Logs upstream payment gateway callbacks for direct payments
model DirectPaymentTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  txnRef        String?
  orderId       String?
  status        String // RECEIVED, PROCESSED, FAILED_VALIDATION
  payload       String   @db.NVarChar(Max)
  receivedAt    DateTime @default(now())

  @@index([orderId])
}

// --------------------------------------
// DELIVERY AGREEMENT & OTP
// --------------------------------------

model DeliveryAgreementTemplate {
  id         String   @id @default(cuid())
  providerId String
  provider   LoanProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  version    Int
  isActive   Boolean  @default(false)
  publishedAt DateTime

  @@unique([providerId, version])
}

model DeliveryOtp {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// ================================================= //
//      NPL COLLECTION (CBS DIGITAL LOAN REPAYMENT)  //
// ================================================= //

// One row per bulk upload of NPL account numbers to the Core Banking System
// for monitoring. The CBS watches those accounts and notifies us when a credit
// lands, which is what drives the auto-debit repayment flow.
model NplCbsUploadBatch {
  id                 String    @id @default(cuid())
  triggeredByUserId  String? // null when triggered by the scheduled worker
  source             String    @default("MANUAL") // MANUAL | SCHEDULED
  status             String    @default("PENDING") // PENDING | SUCCESS | FAILED
  // Number of accounts we sent (clamped to what we actually pushed).
  accountsSentCount  Int       @default(0)
  // Verbatim figures echoed back by the CBS upload endpoint.
  totalReceived      Int?
  insertedCount      Int?
  alreadyExistsCount Int?
  httpStatus         Int?
  errorMessage       String?   @db.NVarChar(Max)
  // JSON array string of account numbers actually included in the upload.
  accountNumbers     String    @db.NVarChar(Max)
  // JSON request and response bodies for traceability.
  requestPayload     String?   @db.NVarChar(Max)
  responsePayload    String?   @db.NVarChar(Max)
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?

  @@index([status])
  @@index([startedAt])
}

// One row per credit notification received from the CBS for a previously
// uploaded NPL account. The notification triggers an immediate auto-repay
// attempt against the CBS /repay endpoint and a corresponding internal
// ledger posting via the standard BNPL repayment pipeline.
model NplCreditNotification {
  id                 String    @id @default(cuid())
  // Notification identity / idempotency.
  externalReference  String?   @unique // optional id sent by the CBS, used for dedup if present
  correlationId      String    @unique // uuid we send back to CBS on /repay (also serves as our internal idempotency key)
  // Inbound payload fields
  accountNumber      String
  creditedAmount     Float
  providerId         String? // CBS provider code (e.g. PRO0001)
  rawPayload         String    @db.NVarChar(Max)
  // Resolution to internal entities (best-effort).
  borrowerId         String?
  loanId             String?
  paymentId          String?
  // Repay result.
  processStatus      String    @default("PENDING") // PENDING | REPAID | PARTIAL_REPAID | NO_OUTSTANDING | UNMATCHED_ACCOUNT | DUPLICATE | FAILED
  resultMessage      String?   @db.NVarChar(Max)
  // Echo of /repay response.
  repayHttpStatus    Int?
  repayTransactionId String?
  repayDebitAmount   Float?
  repayDebitAccount  String?
  repayCreditAccount String?
  repayResponse      String?   @db.NVarChar(Max)
  // Number of attempts (manual retry support).
  attempts           Int       @default(0)
  lastAttemptAt      DateTime?
  receivedAt         DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([accountNumber])
  @@index([processStatus])
  @@index([receivedAt])
  @@index([loanId])
}

// One row per attempt to remove an account from CBS NPL monitoring via
// DELETE /api/v1/notification/delete/{accountNumber}. Deletions fire
// automatically when a borrower exits NPL (loan fully repaid) and can also
// be triggered manually from the NPL Collection admin page to clean up
// accounts that left NPL before the delete integration existed.
model NplCbsDeletion {
  id                String    @id @default(cuid())
  accountNumber     String
  source            String    @default("MANUAL") // MANUAL | AUTO
  status            String    @default("PENDING") // PENDING | SUCCESS | FAILED
  httpStatus        Int?
  reason            String?   @db.NVarChar(Max)
  borrowerId        String?
  triggeredByUserId String? // null when triggered by the auto-repay worker
  responsePayload   String?   @db.NVarChar(Max)
  errorMessage      String?   @db.NVarChar(Max)
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?

  @@index([accountNumber])
  @@index([status])
  @@index([createdAt])
}

// --------------------------------------
// MANUAL REPAYMENT RECORDING
// --------------------------------------

/// A repayment collected off-channel (branch cash, transfer, cheque) and keyed in
/// by a Maker. Nothing moves on the loan until a Checker approves it: posting runs
/// through applyBnplRepayment inside the approval transaction, never at entry.
///
/// Statuses: PENDING_APPROVAL -> APPROVED | REJECTED; an APPROVED row may go
/// PENDING_REVERSAL -> REVERSED. A posted row is never edited, only reversed.
model ManualRepayment {
  id         String @id @default(cuid())
  loanId     String
  loan       Loan   @relation(fields: [loanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  borrowerId String

  amount          Float
  paymentSource   String // CASH, BANK_TRANSFER, CHEQUE, OTHER_CHANNEL
  referenceNumber String
  /// DB-enforced "one reference per payment source". Live rows are keyed
  /// "<source>|<reference>"; a rejected or reversed row is re-keyed with its own id
  /// appended so the branch can re-submit the same genuine bank reference.
  referenceKey    String   @unique
  paymentDate     DateTime
  remarks         String?  @db.NVarChar(Max)

  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  attachmentData String? @db.NVarChar(Max) // base64 receipt / bank slip

  status String @default("PENDING_APPROVAL")

  // Balance the Maker saw at entry; re-read and re-checked at approval time.
  balanceBefore    Float
  principalBefore  Float
  interestBefore   Float
  serviceFeeBefore Float
  penaltyBefore    Float
  taxBefore        Float
  loanStatusBefore String
  /// Installment the quote belonged to, or null for a loan with no schedule.
  installmentNumber Int?

  // Filled in by the posting step: balance before and after, for the audit trail.
  balanceAfter    Float?
  loanStatusAfter String?
  allocation      String?   @db.NVarChar(Max) // JSON: how the amount settled each bucket
  paymentId       String?
  journalEntryId  String?
  postedAt        DateTime?

  makerId        String
  maker          User    @relation("ManualRepaymentMaker", fields: [makerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  makerIp        String?
  makerUserAgent String? @db.Text

  checkerId       String?
  checker         User?     @relation("ManualRepaymentChecker", fields: [checkerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkerIp       String?
  decidedAt       DateTime?
  rejectionReason String?   @db.Text

  reversalReason         String?   @db.Text
  reversalRequestedById  String?
  reversalRequestedAt    DateTime?
  reversedById           String?
  reversedAt             DateTime?
  reversalJournalEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([loanId])
  @@index([borrowerId])
  @@index([paymentDate])
  @@index([makerId])
  @@index([checkerId])
  @@index([referenceNumber])
}

/// Bank-policy knobs for the manual repayment module. Single row, id = 'global'.
model ManualRepaymentConfig {
  id                 String   @id @default("global")
  /// Repayments above this amount are blocked at entry (null = no limit).
  makerApprovalLimit Float?
  requireAttachment  Boolean  @default(false)
  notifyCustomer     Boolean  @default(true)
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ================================================= //
//      TELEGRAM BOT & MINI APP                      //
// ================================================= //

/// A Telegram account that has opened the Mini App or written to the bot.
/// borrowerId is only set after the user shares their own contact with the
/// bot, so it is a phone Telegram has verified. It is deliberately not
/// @unique: SQL Server allows a single NULL in a unique index, and most rows
/// stay unlinked. Code keeps one linked row per phone (see linkTelegramPhone).
model TelegramUser {
  id             String    @id @default(cuid())
  /// Telegram user ids exceed 32 bits, so they are stored as strings.
  telegramUserId String    @unique
  /// Private chat with the bot; null until the user has started a chat.
  chatId         String?
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String?
  /// Normalized 251XXXXXXXXX phone, the same key Borrower.id uses.
  borrowerId     String?
  phoneLinkedAt  DateTime?
  /// Set when Telegram reports the bot is blocked; cleared when the user returns.
  botBlockedAt   DateTime?
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([borrowerId])
}

// ================================================= //
//                 AFFILIATE PROGRAM                 //
// ================================================= //

// An admin-defined affiliate program. Its settings and commission rules live
// in immutable versions: every approved edit publishes a new version. A
// referral locks the version that was current when it was made, so an edit
// only affects referrals made afterwards and never money already earned.
model AffiliateProgram {
  id             String                    @id @default(cuid())
  name           String                    @unique
  description    String?                   @db.NVarChar(Max)
  status         String                    @default("ACTIVE") // ACTIVE, PAUSED
  currentVersion Int                       @default(1)
  // Set while the program is paused. Events that happen while a program is
  // paused never earn a commission, even after it is resumed.
  pausedAt       DateTime?
  // JSON array of finished pause windows: [{ "from": ISO date, "to": ISO date }]
  pausedPeriods  String?                   @db.NVarChar(Max)
  versions       AffiliateProgramVersion[]
  affiliates     Affiliate[]
  payoutBatches  AffiliatePayoutBatch[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

model AffiliateProgramVersion {
  id            String              @id @default(cuid())
  programId     String
  program       AffiliateProgram    @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version       Int
  // JSON AffiliateProgramConfig, validated by src/lib/affiliate/config.ts
  config        String              @db.NVarChar(Max)
  publishedAt   DateTime            @default(now())
  publishedById String? // maker of the approved change
  referrals     AffiliateReferral[]

  @@unique([programId, version])
}

model Affiliate {
  id                String                      @id @default(cuid())
  // Code a referred customer enters in the mini-app.
  code              String                      @unique
  type              String // AGENT, BORROWER, MERCHANT, PARTNER, STAFF
  name              String
  phoneNumber       String                      @unique
  email             String?
  // CBS account commissions are paid into. When empty, a BORROWER affiliate
  // is paid into the active account linked to their phone (PhoneAccount).
  payoutAccount     String?
  programId         String
  program           AffiliateProgram            @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status            String                      @default("ACTIVE") // ACTIVE, SUSPENDED
  suspendedReason   String?                     @db.NVarChar(Max)
  suspendedAt       DateTime?
  // ADMIN: added through maker-checker. SELF: a customer who got their own
  // code on the mini-app's Earn page.
  source            String                      @default("ADMIN")
  // Set when a self-joined customer replaced the generated code (allowed once).
  codeChangedAt     DateTime?
  pointTransactions AffiliatePointTransaction[]
  referrals         AffiliateReferral[]
  commissions       AffiliateCommission[]
  payouts           AffiliatePayout[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([programId])
  @@index([status])
}

// A referred customer. borrowerId is unique: a customer can be referred only
// once, and the referral never moves to another affiliate.
model AffiliateReferral {
  id               String                  @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate               @relation(fields: [affiliateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programVersionId String
  programVersion   AffiliateProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  borrowerId       String                  @unique
  source           String                  @default("CODE") // CODE
  status           String                  @default("ACTIVE") // ACTIVE, REJECTED
  rejectedReason   String?                 @db.NVarChar(Max)
  rejectedAt       DateTime?
  rejectedById     String?
  attributedAt     DateTime                @default(now())
  commissions      AffiliateCommission[]

  @@index([affiliateId])
  @@index([programVersionId])
  @@index([status])
}

// Commission ledger. One row per commission earned (kind EARNED), plus one
// negative row (kind CLAWBACK) when an already-paid commission is taken back;
// a clawback is deducted from the beneficiary's next payout.
model AffiliateCommission {
  id               String            @id @default(cuid())
  // Makes the daily job safe to re-run:
  // EARNED:<referralId>:<ruleId>:<beneficiary>:<sourceId> or CLAWBACK:<commissionId>
  idempotencyKey   String            @unique
  kind             String            @default("EARNED") // EARNED, CLAWBACK
  clawbackOfId     String? // CLAWBACK rows: the EARNED commission taken back
  referralId       String
  referral         AffiliateReferral @relation(fields: [referralId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // The referring affiliate, also for welcome bonuses paid to the customer.
  affiliateId      String
  affiliate        Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiary      String // AFFILIATE, CUSTOMER
  beneficiaryPhone String // who gets paid: the affiliate's phone or the referred borrowerId
  ruleId           String
  ruleName         String?
  eventType        String // LOAN_DISBURSED, LOAN_REPAID, BNPL_ORDER_DELIVERED, DIRECT_ORDER_PAID
  sourceType       String // LOAN, ORDER
  sourceId         String
  loanId           String?
  orderId          String?
  providerId       String? // provider whose product produced the event
  fundedBy         String // PLATFORM, PROVIDER
  baseAmount       Float             @default(0)
  amount           Float
  // MONEY: paid out (PENDING → PAYABLE → IN_PAYOUT → PAID).
  // POINTS: credited to the points wallet when the hold ends (PENDING → CREDITED).
  rewardType       String            @default("MONEY")
  // POINTS rows: amount × the program's earning rate when the row was recorded.
  points           Int?
  status           String            @default("PENDING") // PENDING, PAYABLE, IN_PAYOUT, PAID, CREDITED, REVERSED
  eventDate        DateTime
  holdUntil        DateTime
  payableAt        DateTime?
  // Copy of the rule (and any cap applied) that produced this row.
  ruleSnapshot     String            @db.NVarChar(Max)
  // True once posted to the provider ledger (PROVIDER-funded rows only).
  ledgerPosted     Boolean           @default(false)
  reversedReason   String?           @db.NVarChar(Max)
  reversedAt       DateTime?
  payoutId         String?
  payout           AffiliatePayout?  @relation(fields: [payoutId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([affiliateId, status])
  @@index([referralId])
  @@index([status, holdUntil])
  @@index([loanId])
  @@index([payoutId])
  @@index([clawbackOfId])
}

// The points wallet: every change to a person's points, never edited. A
// balance is the sum of a person's rows.
model AffiliatePointTransaction {
  id             String     @id @default(cuid())
  // One row per business event (EARN:<commissionId>, REVERSAL:<commissionId>,
  // ADJUST:<changeId>), so a retry never posts twice.
  idempotencyKey String     @unique
  // Shown to people and admins, e.g. PTS-261006-7F3K9QAB.
  reference      String     @unique
  // Wallet owner: the affiliate's phone, or the referred customer's borrower id.
  phone          String
  // Set when the points belong to an affiliate.
  affiliateId    String?
  affiliate      Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type           String // EARN, REVERSAL, ADJUST
  points         Int // positive adds, negative removes
  // Birr behind the points when posted: the reward amount, or points × point value for adjustments.
  birrValue      Float      @default(0)
  commissionId   String?
  programId      String?
  note           String?    @db.NVarChar(Max)
  // Adjustments: the maker and the checker.
  createdById    String?
  approvedById   String?
  createdAt      DateTime   @default(now())

  @@index([phone])
  @@index([affiliateId])
  @@index([type, createdAt])
  @@index([commissionId])
}

// Versioned points settings, changed through maker-checker. The latest version applies.
model AffiliatePointsSettingsVersion {
  id            String   @id @default(cuid())
  version       Int      @unique
  // JSON PointsSettings, validated by src/lib/affiliate/config.ts
  config        String   @db.NVarChar(Max)
  publishedAt   DateTime @default(now())
  publishedById String?
}

// Payouts that are approved together through maker-checker.
model AffiliatePayoutBatch {
  id              String            @id @default(cuid())
  programId       String
  program         AffiliateProgram  @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // DRAFT, PENDING_APPROVAL, APPROVED, COMPLETED, PARTIAL, CANCELLED, REJECTED
  status          String            @default("DRAFT")
  source          String            @default("MANUAL") // MANUAL, SCHEDULED
  totalGross      Float             @default(0)
  totalTax        Float             @default(0)
  totalNet        Float             @default(0)
  payoutCount     Int               @default(0)
  createdById     String? // null when prepared by the worker
  submittedById   String?
  submittedAt     DateTime?
  pendingChangeId String?
  approvedById    String?
  approvedAt      DateTime?
  completedAt     DateTime?
  payouts         AffiliatePayout[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([programId])
  @@index([status])
}

// One CBS transfer to one beneficiary.
model AffiliatePayout {
  id               String                @id @default(cuid())
  batchId          String
  batch            AffiliatePayoutBatch  @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiary      String // AFFILIATE, CUSTOMER
  affiliateId      String? // set when the beneficiary is an affiliate
  affiliate        Affiliate?            @relation(fields: [affiliateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  beneficiaryPhone String
  creditAccount    String
  grossAmount      Float
  taxAmount        Float                 @default(0)
  netAmount        Float
  // DRAFT, PENDING_APPROVAL, APPROVED, SENDING, SUCCESS, FAILED, CANCELLED
  status           String                @default("DRAFT")
  transactionId    String?
  requestPayload   String?               @db.NVarChar(Max)
  responsePayload  String?               @db.NVarChar(Max)
  statusCode       Int?
  errorMessage     String?               @db.NVarChar(Max)
  attempts         Int                   @default(0)
  lastAttemptAt    DateTime?
  paidAt           DateTime?
  commissions      AffiliateCommission[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([batchId])
  @@index([status])
  @@index([affiliateId])
}
